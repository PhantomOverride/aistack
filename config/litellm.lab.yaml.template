model_list:
  - model_name: default
    litellm_params:
      model: openai/${AISTACK_DEFAULT_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_DEFAULT_CONTEXT}
  - model_name: code
    litellm_params:
      model: openai/${AISTACK_CODE_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_CODE_CONTEXT}
  - model_name: translate
    litellm_params:
      model: openai/${AISTACK_TRANSLATE_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_TRANSLATE_CONTEXT}
  - model_name: fast
    litellm_params:
      model: openai/${AISTACK_FAST_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_FAST_CONTEXT}
  - model_name: offensive
    litellm_params:
      model: openai/${AISTACK_OFFENSIVE_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_OFFENSIVE_CONTEXT}
  - model_name: embed
    model_info:
      mode: embedding
    litellm_params:
      model: openai/${AISTACK_EMBED_MODEL}
      api_base: ${AISTACK_API_BASE}
      api_key: ${AISTACK_API_KEY}
      extra_body:
        options:
          num_ctx: ${AISTACK_EMBED_CONTEXT}