# Copy to ~/.config/aistack/config.env and replace placeholder values.
# Keep this file private: chmod 600 ~/.config/aistack/config.env

# Optional loopback port overrides.
# LITELLM_PORT=1337
# OLLAMA_PORT=1338
# OPEN_WEBUI_PORT=1339

# Container images. Defaults track upstream latest; pin a tag or digest to freeze.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
OLLAMA_IMAGE=docker.io/ollama/ollama:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Local inference models (required for 'aistack local').
LOCAL_DEFAULT_MODEL=gemma4:e4b-it-qat
LOCAL_CODE_MODEL=gemma4:e4b-it-qat
LOCAL_TRANSLATE_MODEL=translategemma:4b
LOCAL_FAST_MODEL=llama3.2:3b
LOCAL_OFFENSIVE_MODEL=hf.co/prithivMLmods/Qwen3.8-27B-abliterated-GGUF:Q4_K_M
LOCAL_EMBED_MODEL=bge-m3
# Ollama context windows for every local alias.
LOCAL_DEFAULT_CONTEXT=16384
LOCAL_CODE_CONTEXT=65536
LOCAL_TRANSLATE_CONTEXT=16384
LOCAL_FAST_CONTEXT=16384
LOCAL_OFFENSIVE_CONTEXT=65536
LOCAL_EMBED_CONTEXT=16384

# Lite (CPU-first) models (required for 'aistack lite').
LITE_DEFAULT_MODEL=gemma4:e2b-it-qat
LITE_CODE_MODEL=llama3.2:3b
LITE_TRANSLATE_MODEL=translategemma:4b
LITE_FAST_MODEL=llama3.2:3b
LITE_OFFENSIVE_MODEL=hf.co/prithivMLmods/Qwen3.8-27B-abliterated-GGUF:Q4_K_M
LITE_EMBED_MODEL=bge-m3
LITE_DEFAULT_CONTEXT=4096
LITE_CODE_CONTEXT=32768
LITE_TRANSLATE_CONTEXT=4096
LITE_FAST_CONTEXT=4096
LITE_OFFENSIVE_CONTEXT=32768
LITE_EMBED_CONTEXT=4096

# OpenAI-compatible lab endpoint and credential.
LAB_API_BASE=https://lab.example.internal/v1
LAB_API_KEY=replace-with-lab-secret
LAB_DEFAULT_MODEL=lab-default-model
LAB_CODE_MODEL=lab-code-model
LAB_TRANSLATE_MODEL=lab-translate-model
LAB_FAST_MODEL=lab-fast-model
LAB_OFFENSIVE_MODEL=lab-offensive-model
LAB_EMBED_MODEL=bge-m3
# Sent as Ollama-compatible request options; set values supported by the lab endpoint.
LAB_DEFAULT_CONTEXT=16384
LAB_CODE_CONTEXT=65536
LAB_TRANSLATE_CONTEXT=16384
LAB_FAST_CONTEXT=16384
LAB_OFFENSIVE_CONTEXT=65536
LAB_EMBED_CONTEXT=16384

# OpenAI itself or any OpenAI-compatible cloud endpoint and credential.
CLOUD_API_BASE=https://api.openai.com/v1
CLOUD_API_KEY=replace-with-cloud-secret
CLOUD_DEFAULT_MODEL=gpt-5
CLOUD_CODE_MODEL=gpt-5
CLOUD_TRANSLATE_MODEL=gpt-5
CLOUD_FAST_MODEL=gpt-5-mini
CLOUD_OFFENSIVE_MODEL=gpt-5
CLOUD_EMBED_MODEL=text-embedding-3-small

# Set after NVIDIA CDI is installed and verified; leave unset for CPU inference.
# OLLAMA_GPU_DEVICE=nvidia.com/gpu=all
